# Password required to open the demo and call protected routes.
# Fill in: your internal demo password.
# Example format: strong-demo-password-2026
DEMO_ACCESS_PASSWORD=replace_with_internal_demo_password

# Server-side secret for RunPod API access.
# Fill in: your real RunPod API key string.
# Example format: rp_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RUNPOD_API_KEY=rp_replace_with_real_runpod_api_key

# Full GLM runsync endpoint URL.
# Fill in: your deployed GLM endpoint ID inside the URL.
# Example format: https://api.runpod.ai/v2/<glm-endpoint-id>/runsync
RUNPOD_GLM_RUNSYNC_URL=https://api.runpod.ai/v2/2awecunt04grfa/runsync

# Full Qwen runsync endpoint URL.
# Fill in: your deployed Qwen endpoint ID inside the URL.
# Example format: https://api.runpod.ai/v2/<qwen-endpoint-id>/runsync
RUNPOD_QWEN_RUNSYNC_URL=https://api.runpod.ai/v2/0rfonl8fqeeh2z/runsync

# Request timeout in milliseconds for each RunPod call.
# Fill in: integer value.
# Example: 120000 = 120 seconds
RUNPOD_TIMEOUT_MS=120000
